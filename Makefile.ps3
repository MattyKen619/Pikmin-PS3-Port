#---------------------------------------------------------------------------------
# Pikmin PS3 port build (PSL1GHT). Needs the ps3dev toolchain: $PS3DEV and $PSL1GHT set.
#
#   make -f Makefile.ps3 -j4        build build/ps3/pikmin.elf and pikmin.self
#   make -f Makefile.ps3 pkg -j4    also build build/ps3/pikmin.pkg (install with Package Manager)
#   make -f Makefile.ps3 clean
#
# The game data is NOT part of the package: extract it from your own disc with
# tools/ps3/extract_disc.py and copy the PIKMIN folder to a USB drive (see docs in the port notes).
#---------------------------------------------------------------------------------
ifeq ($(strip $(PSL1GHT)),)
$(error "PSL1GHT is not set. Add the ps3dev environment variables to your shell profile.")
endif

include $(PSL1GHT)/ppu_rules

TARGET    := pikmin
BUILD     := build/ps3
BUILDDIR  := $(CURDIR)/$(BUILD)/pkgwork
TITLE     := Pikmin PS3 port (test build)
APPID     := PIKM00001
CONTENTID := UP0001-$(APPID)_00-0000000000000000

#---------------------------------------------------------------------------------
# Sources
#---------------------------------------------------------------------------------
PORT_LIST    := tools/ps3/port_sources.txt
GAME_CPP     := $(shell awk '$$1=="game"{print $$2}' $(PORT_LIST))
JAUDIO_C     := $(shell awk '$$1=="jaudio"{print $$2}' $(PORT_LIST))
GXSDK_C      := $(shell awk '$$1=="gxsdk"{print $$2}' $(PORT_LIST))
LIBS_C       := $(shell awk '$$1=="libs"{print $$2}' $(PORT_LIST))
PLATFORM_CPP := $(wildcard platform/ps3/sdk/*.cpp) $(wildcard platform/ps3/gpu/*.cpp) $(wildcard platform/ps3/stubs/*.cpp)
BACKEND_CPP  := $(wildcard platform/ps3/backend/*.cpp)
# The RSX renderer (with PSL1GHT's fragment program assembler, platform/ps3/rsx/fpasm)
RSX_CPP      := $(wildcard platform/ps3/rsx/*.cpp) $(wildcard platform/ps3/rsx/fpasm/*.cpp)

OBJDIR  := $(BUILD)/obj
objs_of  = $(addprefix $(OBJDIR)/,$(addsuffix .o,$(1)))
OBJECTS := $(call objs_of,$(GAME_CPP) $(JAUDIO_C) $(GXSDK_C) $(LIBS_C) $(PLATFORM_CPP) $(BACKEND_CPP) $(RSX_CPP))
GENDIR  := $(BUILD)/gen

#---------------------------------------------------------------------------------
# Flags
#   Game code and the SDK layer use the game's own headers (include/, MSL in include/stl).
#   The backend uses PSL1GHT/newlib headers. The two must not be mixed in one file.
#---------------------------------------------------------------------------------
OPT       := -O2 -fno-strict-aliasing
# -MMD -MP: each object records the headers it was built from (build/ps3/obj/**/*.d, included below), so
# changing a header rebuilds every file that uses it. (Test 17 ran game code built against an older
# Dolphin/GX/GXFifo.h: its vertex writes never reached the graphics FIFO.)
DEPFLAGS  := -MMD -MP
COMMON    := -mcpu=cell $(MACHDEP) $(OPT) $(DEPFLAGS) -fno-exceptions -funsigned-char -w
# Shown on screen and in the log, so a log can be matched to the build (and ELF) that wrote it.
TEST_BUILD := 45
GAME_DEFS := -DBUILD_VERSION=5 -DVERSION_GPIE01_01 -DDTK_CONFIG_NONMATCHING=1 -DNDEBUG=1 -DTARGET_PS3=1 -DPS3_TEST_BUILD=$(TEST_BUILD)
GAME_INC  := -nostdinc -isystem include/stl -Iinclude -Iplatform/ps3/include

# Game code (C++ and jaudio) is instrumented: function entries and exits keep a shadow call stack and the
# thread's last code address, and exits are thread-switch points ("preemption points" in
# platform/ps3/sdk/os_sched.cpp). The hooks are defined in platform/ps3/include/ps3/hooks.h, included into
# every game file, so the compiler inlines them (test build 36; they were calls through a TOC-switching
# linker stub before). -g1 adds line tables for tools/ps3/symbolize_log.py. The SDK layer is not instrumented.
# Left out:
# - functions defined in headers (small inline accessors and vector math, mostly): each one inlined got its
#   own pair of hooks (test build 33);
# - basic-block hooks (-fsanitize-coverage=trace-pc: a call every few instructions, through a TOC-switching
#   stub) in the code that runs every frame: creatures, AI, effects, models, collision, the sound engine's
#   busiest files. They stay in the system and game-flow code (loading, memory card, movies, menus, sound
#   start-up and streams), where a loop that waits for another thread without calling a function is likely:
#   there they still let interrupts and other threads in. (Known waits use PS3_SPIN_WAIT(), types.h.)
# - the busiest tiny functions, called in the creature search's inner loops (test build 35's profile; the
#   names are matched as substrings): their hooks cost many times their own work.
HOOK_EXCLUDE     := updatable,getChildCount,getCreature,getBoundingSphereRadius,getBoundingSphere,hasInfo,getState,isDone,aiCulling,aiCullable,doCulling,isAlive,available,getAnimMatrix
INSTRUMENT       := -finstrument-functions -finstrument-functions-exclude-file-list=include/ \
                    -finstrument-functions-exclude-function-list=$(HOOK_EXCLUDE) -include platform/ps3/include/ps3/hooks.h -g1
BB_HOOKS         := -fsanitize-coverage=trace-pc
BB_DIRS          := src/sysDolphin src/sysCore src/plugPikiColin src/plugPikiOgawa src/jaudio
BB_SKIP          := src/sysDolphin/dgxGraphics.cpp src/sysDolphin/sysNew.cpp src/sysDolphin/texture.cpp \
                    $(addprefix src/plugPikiColin/,mapMgr.cpp dynsimulator.cpp animMgr.cpp) \
                    $(addprefix src/jaudio/,jammain_2.c dspdriver.c dspbuf.c driverinterface.c dspinterface.c aictrl.c noteon.c \
                      bankdrv.c seqsetup.c ja_calc.c oneshot.c jamosc.c)
bb_hooks          = $(if $(filter-out $(BB_SKIP),$(filter $(addsuffix /%,$(BB_DIRS)),$(1))),$(BB_HOOKS))
PLATFORM_CXXFLAGS := $(COMMON) -std=gnu++14 -fno-rtti -fno-threadsafe-statics $(GAME_DEFS) $(GAME_INC)
# -mstrict-align (game code, Nintendo's libraries): the PPU stops a thread whose floating-point load or store
# is not word-aligned (lv2 does not emulate it). Short of registers, GCC may hold an 8-byte integer in a
# floating-point register and store it with stfd to wherever the integer was going; test build 36 died that
# way copying a string into a member at an odd halfword (zen::ogScrMessageMgr, on the way to the map
# screen). With strict alignment GCC makes no access wider than the alignment it knows. (The port's own
# graphics code is left as it was: GCC 7 crashes compiling gpu_xf.cpp with it.)
STRICT_ALIGN     := -mstrict-align
GAME_CXXFLAGS    := $(PLATFORM_CXXFLAGS) $(STRICT_ALIGN) $(INSTRUMENT)
GAME_CFLAGS      := $(COMMON) $(STRICT_ALIGN) -std=gnu99 $(GAME_DEFS) $(GAME_INC)
BACKEND_CXXFLAGS := $(COMMON) -std=gnu++14 -fno-rtti -DPS3_TEST_BUILD=$(TEST_BUILD) $(LIBPSL1GHT_INC)

# The graphics code (command processor, transform, renderer): square roots as one instruction (no errno).
GPU_OBJS := $(call objs_of,$(wildcard platform/ps3/gpu/*.cpp) $(RSX_CPP))
$(GPU_OBJS): PLATFORM_CXXFLAGS += -fno-math-errno
$(GPU_OBJS): BACKEND_CXXFLAGS += -fno-math-errno

# The graphics thread's code is instrumented for the sampling profiler (platform/ps3/include/ps3/gfx_hooks.h:
# where the thread is, for the "[prof] gfx" lines; test build 41). Left out: functions in headers, the small
# helpers called for every command or vertex, and the files whose code also runs on the game's thread (the
# FIFO writes in gx_fifo.cpp) or seldom (traces, start-up, the fragment program assembler).
GFX_PROFILED     := $(addprefix platform/ps3/gpu/,gpu_cp.cpp gpu_xf.cpp gpu_tex.cpp) \
                    $(addprefix platform/ps3/rsx/,renderer.cpp device_rsx.cpp tev_program.cpp xf_program.cpp vp_builder.cpp)
GFX_HOOK_EXCLUDE := be16,be32,bits,readComp,readColor,component,element,asFloat,selectF,clamp01,clampi,maxf,sqrtF,alignUp,cover
GFX_HOOK_EXCLUDE := $(GFX_HOOK_EXCLUDE),sameBytes,tableSlot,offsetOf,rgb565,rgb5a3,ia8,c3to8,c4to8,c5to8,c6to8,forEachPart,operator,checkStop,rotl
GFX_HOOK_EXCLUDE := $(GFX_HOOK_EXCLUDE),bindAttr,xfWritten,cacheFollow,cacheVariant,setDeviceCull,reserve,checked,missingTexture
GFX_HOOK_EXCLUDE := $(GFX_HOOK_EXCLUDE),loadBp,loadCp,loadXf,loadIndexed,bpWritten,bpUse,ioOffset,xfSetupGroups,setupLights,setupPosts,tevRegFromBp,newTexture
GFX_PROFILE      := -finstrument-functions -finstrument-functions-exclude-file-list=.h \
                    -finstrument-functions-exclude-function-list=$(GFX_HOOK_EXCLUDE) -include platform/ps3/include/ps3/gfx_hooks.h -g1
$(call objs_of,$(GFX_PROFILED)): PLATFORM_CXXFLAGS += $(GFX_PROFILE)
$(call objs_of,$(GFX_PROFILED)): BACKEND_CXXFLAGS += $(GFX_PROFILE)

LIBS    := -laudio -lsysmodule -lrsx -lgcm_sys -lio -lsysutil -lrt -llv2 -lm
LDFLAGS := $(MACHDEP) -Wl,--gc-sections -Wl,-Map,$(BUILD)/$(TARGET).map

#---------------------------------------------------------------------------------
.PHONY: all pkg clean
all: $(BUILD)/$(TARGET).self

pkg: $(BUILD)/$(TARGET).pkg

$(BUILD)/$(TARGET).elf: $(OBJECTS)
	@echo linking ... $(notdir $@)
	@$(CXX) $(LDFLAGS) $(OBJECTS) $(LIBPSL1GHT_LIB) $(LIBS) -o $@
	@python3 tools/ps3/check_imports.py $@ --allow cellSysmodule --allow cellAudio || (rm -f $@; false)
	@! $(PREFIX)nm -u $(call objs_of,$(RSX_CPP)) | grep -E ' _Zn[wa]' || (echo "the renderer must not use the game's operator new (platform/ps3/rsx/rsx_alloc.h)"; rm -f $@; false)
	@mkdir -p $(BUILD)/archive/test$(TEST_BUILD) && cp $@ $(BUILD)/$(TARGET).map $(BUILD)/archive/test$(TEST_BUILD)/

# game C++
$(call objs_of,$(GAME_CPP)): $(OBJDIR)/%.o: %
	@mkdir -p $(dir $@)
	@echo $<
	@$(CXX) $(GAME_CXXFLAGS) $(call bb_hooks,$<) -c $< -o $@

# Nintendo SDK replacement (game headers, not instrumented)
$(call objs_of,$(PLATFORM_CPP)): $(OBJDIR)/%.o: %
	@mkdir -p $(dir $@)
	@echo $<
	@$(CXX) $(PLATFORM_CXXFLAGS) -c $< -o $@

# jaudio: .c files that the original build compiles as C++.
$(call objs_of,$(JAUDIO_C)): $(OBJDIR)/%.o: %
	@mkdir -p $(dir $@)
	@echo $<
	@$(CXX) $(GAME_CXXFLAGS) $(call bb_hooks,$<) -x c++ -c $< -o $@

# Nintendo's GX library: C compiled as C++ (its write-gather pipe, GXWGFifo, is a C++ object on the PS3).
# -fpermissive: the C code converts between ints and enums, and casts pointers to u32 (addresses fit).
# Not instrumented: the game calls it constantly, and it has no loops that wait for another thread
# without calling an SDK function (GXWaitDrawDone sleeps in OSSleepThread).
$(call objs_of,$(GXSDK_C)): $(OBJDIR)/%.o: %
	@mkdir -p $(dir $@)
	@echo $<
	@$(CXX) $(PLATFORM_CXXFLAGS) $(STRICT_ALIGN) -g1 -fpermissive -x c++ -c $< -o $@

# C libraries (mtx, hvqm4dec, MSL float constants)
$(call objs_of,$(LIBS_C)): $(OBJDIR)/%.o: %
	@mkdir -p $(dir $@)
	@echo $<
	@$(CC) $(GAME_CFLAGS) -c $< -o $@

# PS3 system backend
$(call objs_of,$(BACKEND_CPP)): $(OBJDIR)/%.o: %
	@mkdir -p $(dir $@)
	@echo $<
	@$(CXX) $(BACKEND_CXXFLAGS) -c $< -o $@

# RSX renderer (PS3 SDK headers, like the backend; the vertex program is assembled by cgcomp)
$(call objs_of,$(RSX_CPP)): $(OBJDIR)/%.o: % | $(GENDIR)/passthrough_vpo.h
	@mkdir -p $(dir $@)
	@echo $<
	@$(CXX) $(BACKEND_CXXFLAGS) -I$(GENDIR) -c $< -o $@

$(GENDIR)/passthrough_vpo.h: platform/ps3/rsx/passthrough.vp tools/ps3/bin2h.py
	@mkdir -p $(GENDIR)
	@echo $<
	@$(PS3DEV)/bin/cgcomp -v -a $< $(GENDIR)/passthrough.vpo
	@python3 tools/ps3/bin2h.py $(GENDIR)/passthrough.vpo kPassthroughVpo $@

# The SPU sound mixer (platform/ps3/spu/dsp_spu.cpp, test build 44): an SPU program, built into the ELF as an
# array (build/ps3/gen/dsp_spu_elf.h) that platform/ps3/backend/ps3_spu.cpp starts.
SPU_CXX      := $(PS3DEV)/spu/bin/spu-g++
SPU_STRIP    := $(PS3DEV)/spu/bin/spu-strip
SPU_DIR      := $(BUILD)/spu
SPU_CXXFLAGS := -O2 -std=gnu++14 -fno-exceptions -fno-rtti -ffunction-sections -fdata-sections -Wall -Wno-unused-function \
                -Iplatform/ps3/include -Iplatform/ps3/sdk -I$(PSL1GHT)/spu/include
$(SPU_DIR)/dsp_spu.elf: platform/ps3/spu/dsp_spu.cpp Makefile.ps3
	@mkdir -p $(SPU_DIR)
	@echo $<
	@$(SPU_CXX) $(SPU_CXXFLAGS) -MMD -MP -MF $(SPU_DIR)/dsp_spu.d -MT $@ $< -L$(PSL1GHT)/spu/lib -lsputhread -Wl,--gc-sections -o $@

$(GENDIR)/dsp_spu_elf.h: $(SPU_DIR)/dsp_spu.elf tools/ps3/bin2h.py
	@mkdir -p $(GENDIR)
	@$(SPU_STRIP) -o $(SPU_DIR)/dsp_spu_stripped.elf $<
	@python3 tools/ps3/bin2h.py $(SPU_DIR)/dsp_spu_stripped.elf ps3_dsp_spu_elf $@ 128

$(OBJDIR)/platform/ps3/backend/ps3_spu.cpp.o: $(GENDIR)/dsp_spu_elf.h
$(OBJDIR)/platform/ps3/backend/ps3_spu.cpp.o: BACKEND_CXXFLAGS += -I$(GENDIR)
-include $(SPU_DIR)/dsp_spu.d

clean:
	@rm -rf $(BUILD)

-include $(OBJECTS:.o=.d)

# The build number is a command-line define: the two files that show it rebuild when it changes.
$(OBJDIR)/platform/ps3/sdk/platform_init.cpp.o $(OBJDIR)/platform/ps3/backend/ps3_console.cpp.o: Makefile.ps3
