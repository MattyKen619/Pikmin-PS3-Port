#---------------------------------------------------------------------------------
# Pikmin PS3 port build (PSL1GHT). Needs the ps3dev toolchain: $PS3DEV and $PSL1GHT set.
#
#   make -f Makefile.ps3 -j4        build build/ps3/pikmin.elf and pikmin.self
#   make -f Makefile.ps3 pkg -j4    also build build/ps3/pikmin.pkg (install with Package Manager)
#   make -f Makefile.ps3 clean
#
# The game data is NOT part of the package: extract it from your own disc with
# tools/ps3/extract_disc.py and copy the PIKMIN folder to a USB drive (see docs in the port notes).
#---------------------------------------------------------------------------------
ifeq ($(strip $(PSL1GHT)),)
$(error "PSL1GHT is not set. Add the ps3dev environment variables to your shell profile.")
endif

include $(PSL1GHT)/ppu_rules

TARGET    := pikmin
BUILD     := build/ps3
BUILDDIR  := $(CURDIR)/$(BUILD)/pkgwork
TITLE     := Pikmin PS3 port (test build)
APPID     := PIKM00001
CONTENTID := UP0001-$(APPID)_00-0000000000000000

#---------------------------------------------------------------------------------
# Sources
#---------------------------------------------------------------------------------
PORT_LIST    := tools/ps3/port_sources.txt
GAME_CPP     := $(shell awk '$$1=="game"{print $$2}' $(PORT_LIST))
JAUDIO_C     := $(shell awk '$$1=="jaudio"{print $$2}' $(PORT_LIST))
LIBS_C       := $(shell awk '$$1=="libs"{print $$2}' $(PORT_LIST))
PLATFORM_CPP := $(wildcard platform/ps3/sdk/*.cpp) $(wildcard platform/ps3/stubs/*.cpp)
BACKEND_CPP  := $(wildcard platform/ps3/backend/*.cpp)

OBJDIR  := $(BUILD)/obj
objs_of  = $(addprefix $(OBJDIR)/,$(addsuffix .o,$(1)))
OBJECTS := $(call objs_of,$(GAME_CPP) $(JAUDIO_C) $(LIBS_C) $(PLATFORM_CPP) $(BACKEND_CPP))

#---------------------------------------------------------------------------------
# Flags
#   Game code and the SDK layer use the game's own headers (include/, MSL in include/stl).
#   The backend uses PSL1GHT/newlib headers. The two must not be mixed in one file.
#---------------------------------------------------------------------------------
OPT       := -O2 -fno-strict-aliasing
COMMON    := -mcpu=cell $(MACHDEP) $(OPT) -fno-exceptions -funsigned-char -w
GAME_DEFS := -DBUILD_VERSION=5 -DVERSION_GPIE01_01 -DDTK_CONFIG_NONMATCHING=1 -DNDEBUG=1 -DTARGET_PS3=1
GAME_INC  := -nostdinc -isystem include/stl -Iinclude -Iplatform/ps3/include

GAME_CXXFLAGS    := $(COMMON) -std=gnu++14 -fno-rtti -fno-threadsafe-statics $(GAME_DEFS) $(GAME_INC)
GAME_CFLAGS      := $(COMMON) -std=gnu99 $(GAME_DEFS) $(GAME_INC)
BACKEND_CXXFLAGS := $(COMMON) -std=gnu++14 -fno-rtti $(LIBPSL1GHT_INC)

LIBS    := -lrsx -lgcm_sys -lio -lsysutil -lsysfs -lrt -llv2 -lm
LDFLAGS := $(MACHDEP) -Wl,--gc-sections -Wl,-Map,$(BUILD)/$(TARGET).map

#---------------------------------------------------------------------------------
.PHONY: all pkg clean
all: $(BUILD)/$(TARGET).self

pkg: $(BUILD)/$(TARGET).pkg

$(BUILD)/$(TARGET).elf: $(OBJECTS)
	@echo linking ... $(notdir $@)
	@$(CXX) $(LDFLAGS) $(OBJECTS) $(LIBPSL1GHT_LIB) $(LIBS) -o $@

# game C++
$(addprefix $(OBJDIR)/,$(addsuffix .o,$(GAME_CPP) $(PLATFORM_CPP))): $(OBJDIR)/%.o: %
	@mkdir -p $(dir $@)
	@echo $<
	@$(CXX) $(GAME_CXXFLAGS) -c $< -o $@

# jaudio: .c files that the original build compiles as C++
$(call objs_of,$(JAUDIO_C)): $(OBJDIR)/%.o: %
	@mkdir -p $(dir $@)
	@echo $<
	@$(CXX) $(GAME_CXXFLAGS) -x c++ -c $< -o $@

# C libraries (mtx, hvqm4dec, MSL float constants)
$(call objs_of,$(LIBS_C)): $(OBJDIR)/%.o: %
	@mkdir -p $(dir $@)
	@echo $<
	@$(CC) $(GAME_CFLAGS) -c $< -o $@

# PS3 system backend
$(call objs_of,$(BACKEND_CPP)): $(OBJDIR)/%.o: %
	@mkdir -p $(dir $@)
	@echo $<
	@$(CXX) $(BACKEND_CXXFLAGS) -c $< -o $@

clean:
	@rm -rf $(BUILD)
